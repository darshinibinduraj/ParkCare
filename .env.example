# Hosted Postgres (Neon, Supabase, or Vercel Postgres).
# Leave blank to use embedded Postgres (PGlite) in .data/pglite so the demo runs locally.
DATABASE_URL=

# Optional. When unset, ParkCare plans on the server with a built-in planner
# and does not send answers to an outside AI service.
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
