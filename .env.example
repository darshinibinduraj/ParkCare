# Hosted Postgres (Neon, Supabase, or Vercel Postgres).
# Leave blank to use embedded Postgres (PGlite) in .data/pglite so the demo runs locally.
DATABASE_URL=

# Optional. When unset, ParkCare plans on the server with a built-in planner
# and does not send answers to an outside AI service.
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Python agent service. The Next.js app calls this for A2A runs.
# Leave as the local default. If it is down, the site still plans in-process.
AGENTS_URL=http://127.0.0.1:8000

# Set on the Python service, not required for Next.js.
# PARKCARE_SLIM=1
# SLIM_URL=http://127.0.0.1:46357
